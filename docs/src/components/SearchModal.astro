---
/*
 * The ⌘K search modal — the reference's `.modal`, with the result rows left
 * empty for Pagefind to fill at runtime.
 *
 * Pagefind's own UI bundle is deliberately not used: it ships its own markup
 * and stylesheet, which would have to be fought back into this shape. Its
 * JS API returns plain data, so the rows here are rendered by `search.ts`
 * into exactly the `.hit` markup the design specifies.
 */
---

<div class="modal" hidden data-modal>
  <div class="modal__panel" role="dialog" aria-modal="true" aria-label="Search the docs">
    <div class="modal__top">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#EC3013" stroke-width="2.4" aria-hidden="true"
        ><circle cx="11" cy="11" r="7"></circle><path d="M20 20 L16.2 16.2"></path></svg
      >
      <input type="text" placeholder="Search the docs" data-search-input aria-label="Search the docs" />
      <span class="kbd">ESC</span>
    </div>

    <div class="modal__list" data-search-results></div>

    <div class="modal__foot">
      <span><span class="kbd">↑↓</span> navigate</span>
      <span><span class="kbd">↵</span> open</span>
      <span><span class="kbd">ESC</span> close</span>
      <span class="count" data-search-count></span>
    </div>
  </div>
</div>
