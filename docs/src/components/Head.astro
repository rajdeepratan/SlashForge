---
/*
 * Everything inside <head>, shared by both layouts.
 *
 * Starlight used to generate all of this. The pieces worth keeping were the
 * canonical URL, the og:image block (Starlight declared a large-image Twitter
 * card but never emitted an image, so shares rendered blank), and the inline
 * theme script that prevents a flash of the wrong theme.
 */
interface Props {
  title: string;
  description?: string;
  /** Set on the home page, where the title already carries the pitch. */
  rawTitle?: boolean;
  /** Sidebar group, used for the breadcrumb trail on documentation pages. */
  section?: string;
  /** ISO date the page last changed, from git. */
  updated?: string;
}

const { title, description, rawTitle = false, section, updated } = Astro.props;

const site = Astro.site?.origin ?? '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = `${site}${base}/og.png`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const home = `${site}${base}/`;

/*
 * Structured data.
 *
 * The home page describes the software itself; every other page is a
 * TechArticle with a breadcrumb trail. Without this a search engine has to
 * infer what the site is from prose alone, and the docs lose any chance of a
 * rich result.
 */
const schema = rawTitle
  ? {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'SlashForge',
      description,
      url: home,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'macOS, Linux, Windows',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      license: 'https://opensource.org/licenses/MIT',
      author: { '@type': 'Person', name: 'Rajdeep Ratan' },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'TechArticle',
      headline: title,
      description,
      url: canonical,
      ...(updated ? { dateModified: updated } : {}),
      author: { '@type': 'Person', name: 'Rajdeep Ratan' },
      isPartOf: { '@type': 'WebSite', name: 'SlashForge', url: home },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'SlashForge', item: home },
          ...(section ? [{ '@type': 'ListItem', position: 2, name: section }] : []),
          { '@type': 'ListItem', position: section ? 3 : 2, name: title, item: canonical },
        ],
      },
    };
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{rawTitle ? title : `${title} — SlashForge`}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical} />
<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
<meta name="generator" content={Astro.generator} />

<meta property="og:type" content={rawTitle ? 'website' : 'article'} />
<meta property="og:site_name" content="SlashForge" />
<meta property="og:locale" content="en" />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1280" />
<meta property="og:image:height" content="640" />
<meta property="og:image:alt" content="SlashForge" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

{/* Inlined and render-blocking on purpose: it has to set the theme before the
    first paint, or the page flashes light before switching to dark. */}
<script is:inline>
	(() => {
		let theme = null;
		try {
			theme = localStorage.getItem('sf-theme');
		} catch {}
		if (!theme) {
			theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		}
		document.documentElement.dataset.theme = theme;
	})();
</script>
