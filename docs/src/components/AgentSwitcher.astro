---
/*
 * The coding-agent picker. It lives in the header on every docs page, and in the
 * landing page's banner instead (Base's agentInHeader). One per page: the menu
 * script in site.js finds a single trigger and menu by id.
 */
import { TARGETS, DEFAULT_TARGET } from '../targets.mjs';

interface Props {
  /** 'hero' opens the menu from the left edge, under the banner's buttons. */
  placement?: 'header' | 'hero';
}
const { placement = 'header' } = Astro.props;

const TARGET_LABELS = { claude: 'Claude', cursor: 'Cursor', codex: 'Codex' };
---

{/* The only target control on the seven pages that mention commands but
    contain no code block. Shaped like the theme button beside it: a flat
    ruled control, not a second accent block competing with the nav.

    A real menu rather than a <select>, because the native popup is drawn
    by the OS — rounded, shadowed, floating — and cannot be styled. This
    site's rule is that nothing is round and nothing floats.

    The label is a sibling of the value so it can drop on narrow screens,
    leaving "CLAUDE" — about as wide as "DARK". */}
<div class:list={["agentsw", placement === "hero" && "agentsw--hero"]}>
  <button
    class="agentsw__btn"
    type="button"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="agent-menu"
    data-agent-trigger
  >
    <span class="agentsw__label">Agent:</span>
    <span class="agentsw__value" data-target-value>{TARGET_LABELS[DEFAULT_TARGET]}</span>
    <span class="agentsw__caret" aria-hidden="true"></span>
  </button>

  <div class="agentsw__menu" id="agent-menu" role="menu" aria-label="Coding agent" hidden>
    {
      TARGETS.map((t) => (
        <button
          class="agentsw__item"
          type="button"
          role="menuitemradio"
          data-target-opt={t}
          aria-checked={String(t === DEFAULT_TARGET)}
        >
          {TARGET_LABELS[t]}
        </button>
      ))
    }
  </div>
</div>

