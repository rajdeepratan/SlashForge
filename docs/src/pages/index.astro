---
/*
 * The home page — the reference `index.html` body, with its repeated blocks
 * lifted into data.
 *
 * This is a plain Astro route rather than a content entry, which is the whole
 * point: the bands are full-bleed, and under Starlight the page rendered six
 * wrappers deep inside a width-capped `sl-container`, so the ember poster
 * physically could not reach the viewport edges.
 */
import Base from '../layouts/Base.astro';
import { version, nodeFloor } from '../pkg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Kept in sync with the phases on /slashforge:code. This is the shape of a run,
// not a transcript of one — the annotated page says so explicitly.
const DEMO: [string, string][] = [
  ['t-cmd', '$ /slashforge:code'],
  ['t-you', '> add rate limiting to the public API'],
  ['t-out', ''],
  ['t-phase', 'PHASE 2 · PLAN'],
  ['t-out', '  rateLimit.ts   new — token bucket, Redis-backed'],
  ['t-out', '  server.ts      mount before route handlers'],
  ['t-out', '  RISKS          a Redis outage would fail open'],
  ['t-out', '  TESTS         refill · boundary 100 · per-key isolation'],
  ['t-out', ''],
  ['t-phase', 'PHASE 3 · CONFIRM — stops and waits for you'],
  ['t-you', '> proceed'],
  ['t-out', ''],
  ['t-phase', 'PHASE 6 · VERIFY'],
  ['t-ok', '  lint ✓    tests ✓    build ✓'],
  ['t-out', ''],
  ['t-phase', 'PHASE 7 · REVIEW'],
  ['t-out', '  code-reviewer · matches the plan · 0 blocking'],
  ['t-out', ''],
  ['t-phase', 'PHASE 8 · PR opened against main'],
  ['t-out', '  Nothing shipped that was not planned, gated, verified.'],
];

const REVIEW_DEMO: [string, string][] = [
  ['t-cmd', '$ /slashforge:review-pr'],
  ['t-out', ''],
  ['t-phase', 'AWAITING YOUR REVIEW'],
  ['t-out', '  1. #42  Add retry to upload queue   +180 −24  (6 files)'],
  ['t-out', '  2. #47  Bump astro to 7.2            +12 −12  (2 files)'],
  ['t-you', '> 1'],
  ['t-out', ''],
  ['t-phase', 'CONTEXT'],
  ['t-out', '  CI green · 2 existing comments · author is not you'],
  ['t-out', ''],
  ['t-phase', 'FINDINGS · against CLAUDE.md and .claude/rules/'],
  ['t-out', '  blocking    retry.ts:38   no cap, retries forever'],
  ['t-out', '  should fix  retry.ts:52   swallows the abort signal'],
  ['t-out', '  nit         retry.ts:12   name says ms, value is s'],
  ['t-out', ''],
  ['t-phase', 'GATE · nothing is posted yet'],
  ['t-out', '  approve · comment · request-changes · edit · cancel'],
  ['t-you', '> request-changes'],
  ['t-out', ''],
  ['t-phase', 'POSTED · 3 line comments on #42'],
  ['t-out', '  You saw the exact text before it went out.'],
];

const commands = [
  {
    name: '/slashforge:setup',
    href: 'commands/slashforge-setup',
    desc: 'One-time repo setup. Explores the codebase, asks clarifying questions, then generates CLAUDE.md, rules, skills, agents, commands, and hooks tailored to it.',
  },
  {
    name: '/slashforge:code',
    href: 'commands/slashforge-code',
    desc: 'End-to-end development. Ten phases from plan to merged PR, with mandatory stop-and-confirm gates. Add -quick for lean mode on small changes.',
  },
  {
    name: '/slashforge:investigate',
    href: 'commands/slashforge-investigate',
    desc: 'Read-only research. Reproduces and root-causes a bug, then writes a findings report. Never touches your code.',
  },
  {
    name: '/slashforge:review-pr',
    href: 'commands/slashforge-review-pr',
    desc: "Reviews a pull request against your repo's own rules and conventions, then posts line-level comments or approves. Never posts without showing you the exact text.",
  },
];

const costs = [
  {
    label: 'Full run',
    value: '100–250k',
    note: 'Ten phases, four gates, agent code review. A multi-layer feature lands near the top.',
  },
  {
    label: 'With Graphify',
    value: '75–225k',
    note: 'The graph shaves roughly 4–10%. It does not change the order of magnitude.',
  },
  {
    label: 'Lean mode (-quick)',
    value: '40–70k',
    note: 'Skips brainstorming and the review agent. Every user gate and all verification stay.',
  },
  {
    label: 'Repo setup',
    value: '50–120k',
    note: 'Once per repo. The largest fixed load of any command, then it writes your .claude/.',
  },
  {
    label: 'Reviewing a PR',
    value: '15–70k',
    note: 'Almost entirely the diff. Three files is about 2k of it; fourteen is about 42k.',
  },
  {
    label: 'Investigating a bug',
    value: '15–60k',
    note: 'No code is written, so this is reading — however far the trail runs before the cause.',
  },
];
---

<Base
  title="SlashForge — workflow slash commands for AI coding agents"
  description="Workflow slash commands for AI coding agents — /slashforge:setup, /slashforge:code, /slashforge:investigate, /slashforge:review-pr."
  rawTitle
>
  <main>
    <section class="hero">
      <div class="band band--full hero__grid">
        <div class="hero__copy">
          <h1 class="hero__title">Workflow slash commands for AI coding agents.</h1>
          <p class="hero__line hero__line--accent">Guardrails, not autocomplete.</p>
          <div class="actions">
            <a class="btn btn--primary" href={`${base}/guides/introduction/`}>Get Started</a>
            <a
              class="btn btn--ghost"
              href="https://github.com/rajdeepratan/SlashForge"
              target="_blank"
              rel="noopener"
            >
              View on GitHub
            </a>
          </div>

          <div class="rail">
            <div class="label">Install</div>
            <div class="rail__cmd"><i>$ </i>npx slashforge</div>
            <p class="rail__note">
              Supports <strong>Claude Code</strong> today. Cursor and Codex targets are planned.
            </p>
            <div class="rail__facts"><span>Node {nodeFloor}</span><span>MIT</span><span>v{version}</span></div>
          </div>
        </div>

        <div class="replay">
          <div class="replay__head">
            <h2>Two runs, start to finish</h2>
            <div class="replay__controls">
              <a class="replay__link" href={`${base}/guides/example-run/`}>Read it annotated →</a>
            </div>
          </div>
          <div class="terms">
            <div class="terms__col" data-replay>
              <div class="terms__head">
                <h3>Shipping a feature</h3>
                <button class="replay__btn" type="button" data-replay-btn>Replay</button>
              </div>
              <div class="term">
                <div class="term__bar">
                  <svg width="11" height="11" viewBox="0 0 64 64" aria-hidden="true"
                    ><path d="M40 6 H48 L52.4 13.2 L30 58 H22 L17.6 50.8 Z" fill="#EC3013"></path></svg
                  >
                  <span>feat/rate-limiting</span>
                  <span class="term__status" data-replay-status>complete</span>
                </div>
                <div class="term__body" data-replay-body>
                  {DEMO.map(([kind, text]) => <div class={kind}>{text}</div>)}
                </div>
              </div>
            </div>

            <div class="terms__col" data-replay>
              <div class="terms__head">
                <h3>Reviewing someone else's</h3>
                <button class="replay__btn" type="button" data-replay-btn>Replay</button>
              </div>
              <div class="term">
                <div class="term__bar">
                  <svg width="11" height="11" viewBox="0 0 64 64" aria-hidden="true"
                    ><path d="M40 6 H48 L52.4 13.2 L30 58 H22 L17.6 50.8 Z" fill="#EC3013"></path></svg
                  >
                  <span>reviewing #42</span>
                  <span class="term__status" data-replay-status>complete</span>
                </div>
                <div class="term__body" data-replay-body>
                  {REVIEW_DEMO.map(([kind, text]) => <div class={kind}>{text}</div>)}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="band">
        <div class="section__head">
          <h2>Four commands</h2>
          <span class="label">Each command triggers one distinct workflow</span>
        </div>
        <div class="cells cells--quad">
          {
            commands.map((c) => (
              <a class="cell cell--link" href={`${base}/${c.href}/`}>
                <code>{c.name}</code>
                <p>{c.desc}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="band">
        <div class="section__head">
          <h2>What it costs</h2>
          <span class="label">Tokens per run</span>
        </div>
        <div class="cells">
          {
            costs.map((c) => (
              <div class="cell">
                <div class="label">{c.label}</div>
                <div class="cell__value">{c.value}</div>
                <p>{c.note}</p>
              </div>
            ))
          }
        </div>
        <p class="caveat">
          The range is driven by the size of the work, not by the tooling. SlashForge is
          deliberately heavy — if you want a prompt turned into a patch as fast as possible, this is
          the wrong tool.
        </p>
      </div>
    </section>

    <section class="poster">
      <div class="band band--full">
        <p>It empowers people to do their finest work every single time.</p>
        <a href={`${base}/guides/introduction/`}>Read the introduction <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</Base>
